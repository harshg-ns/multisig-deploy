project Tests is

   --  Mirrors quorum.gpr's modes so the suite can be run against the profile
   --  that actually ships: QUORUM_MODE=release ./test/run.sh
   type Build_Mode is ("dev", "release");
   Mode : Build_Mode := external ("QUORUM_MODE", "dev");

   for Source_Dirs use ("src", "test");
   for Exec_Dir use "test";
   for Main use ("harness.adb");

   case Mode is
      when "dev"     => for Object_Dir use "obj-test";
      when "release" => for Object_Dir use "obj-test-release";
   end case;

   Common := ("-gnat2022", "-gnatwa", "-gnatVa", "-gnata", "-gnatf");

   package Compiler is
      case Mode is
         when "dev" =>
            for Default_Switches ("Ada") use Common & ("-g");
         when "release" =>
            for Default_Switches ("Ada") use
              Common & ("-Os", "-ffunction-sections", "-fdata-sections");
      end case;
   end Compiler;

end Tests;
